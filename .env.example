# =====================================================================
# 懒人模式配置模板
# =====================================================================
#   cp .env.example .env   然后填入下面两个密钥，即可直接运行：
#   uv run python run.py "你的调研问题"
#
# .env 已被 .gitignore 排除，不会上传到仓库。
# 密钥优先级：真实环境变量 > .env > config/*.yml 里的默认值。
# =====================================================================

# ---- LLM（二选一，按你使用的 config 填写）----
# 阿里云百炼 / 通义千问：https://bailian.console.aliyun.com/
QWEN_API_KEY=

# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---- 联网检索（必填）----
# Tavily：https://tavily.com/
TAVILY_API_KEY=


# ---- 以下均为可选 ----

# 默认使用的配置文件与 stage（等价于命令行 --config / --stage）
# CONFIG_PATH=config/qwen.yml
# STAGE=prod

# 调研深度档位：quick / standard / deep（等价于命令行 --depth）
# RESEARCH_DEPTH=standard

# 日志等级：DEBUG / INFO / WARNING
# DEEP_RESEARCH_LOG_LEVEL=INFO

# LangSmith 链路追踪：https://smith.langchain.com/
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=DeepResearch
